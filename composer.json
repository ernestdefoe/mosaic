{
    "name": "ernestdefoe/mosaic",
    "description": "Mosaic — a polished, configurable Flarum 2 theme with a tiled hero, category grid, sidebar widgets, and optional integrations for support tickets (linkrobins/support) and a marketplace storefront (ramon/marketplace).",
    "keywords": [
        "flarum",
        "flarum-extension",
        "theme",
        "mosaic"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ernestdefoe/mosaic/issues",
        "source": "https://github.com/ernestdefoe/mosaic"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Mosaic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Mosaic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Mosaic",
            "category": "theme",
            "icon": {
                "name": "fas fa-shapes",
                "backgroundColor": "#2563eb",
                "color": "#ffffff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
